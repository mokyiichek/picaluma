{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Picaluma",
  "version": "0.7.9",
  "identifier": "com.mokyiichek.picaluma",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "mokyiichek",
    "shortDescription": "Fast open-source photo organizer",
    "longDescription": "Picaluma is a fast, open-source photo organizer and editor inspired by the workflow of Picasa 3.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
